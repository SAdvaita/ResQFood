# ─── Core ─────────────────────────────────────────────
PORT=5005
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/resqfood
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=localhost

# ─── JWT ──────────────────────────────────────────────
ACCESS_TOKEN_SECRET=replace_with_long_random_secret
REFRESH_TOKEN_SECRET=replace_with_different_long_secret
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# ─── Twilio (SMS OTP) – optional ──────────────────────
TWILIO_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE=+1...

# ─── SMTP (Email) – optional ──────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@resqfood.com

# ─── Cloudinary (Images) – optional ──────────────────
CLOUDINARY_CLOUD_NAME=your_cloud
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret
